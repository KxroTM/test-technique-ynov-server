# Port d'écoute du serveur API
PORT=8080

# Chaîne de connexion PostgreSQL (doit correspondre à docker-compose.yml)
DATABASE_URL=postgres://notes_user:notes_password@localhost:5432/notes_db?sslmode=disable

# Clé de signature des jetons JWT.
JWT_SECRET=change-me-in-production

# Connexion Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
