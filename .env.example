# Copier ce fichier vers .env puis adapter les valeurs.
# Le fichier .env n'est jamais versionné : il contient des secrets.

# Port d'écoute du serveur API
PORT=8080

# Chaîne de connexion PostgreSQL (doit correspondre à docker-compose.yml)
DATABASE_URL=postgres://notes_user:notes_password@localhost:5432/notes_db?sslmode=disable

# Clé de signature des jetons JWT.
# En production, utiliser une valeur aléatoire longue et secrète.
JWT_SECRET=change-me-in-production
